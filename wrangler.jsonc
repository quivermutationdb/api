/**
 * Quiver Mutation Database — one Worker serving the API (/api/*) and the
 * static frontend (Workers Static Assets). Same origin, no CORS.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qmd",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // Production hostnames (Custom Domains on the quivermutationdb.org zone).
  // Declared here so the repo fully describes the deployment; the dashboard
  // attachment was made first and deploys keep it in sync.
  "routes": [
    { "pattern": "quivermutationdb.org", "custom_domain": true },
    { "pattern": "www.quivermutationdb.org", "custom_domain": true }
  ],

  // Static frontend (the site's HTML/CSS/JS, served as Workers Static Assets).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Multi-page static site, not an SPA: serve /404.html for missing paths.
    "not_found_handling": "404-page",
    // API requests must reach the Worker; everything else is served as assets.
    "run_worker_first": ["/api/*", "/mcp"]
  },

  // PlanetScale Postgres, reached through Hyperdrive (pooling + edge cache).
  // Created from the Cloudflare dashboard 2026-09-09 so it bills to the ICARM
  // Cloudflare account; docs/PLANETSCALE.md is the migration record.
  //
  // THE database as of the 2026-09-09 cutover. The five D1 bindings that stood
  // here (qmd + qmd-n6-0..3) are gone; the D1 databases themselves still exist
  // and are the rollback until they are deliberately deleted.
  //
  // localConnectionString is what `wrangler dev` and CI connect to; `id` is
  // used only in production. Override it per-machine with the
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE variable rather
  // than editing this file.
  //
  // Caching is ON by default (60 s, 1 h max) and is NOT invalidated by writes,
  // so after a data release the cache serves the previous census until it
  // expires. Decide deliberately: short max_age, or rotate the config as a
  // release step (docs/PLANETSCALE.md, "Sticking points").
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "3102c79867ae4311b621240f7f200bbe",
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/qmd"
    }
  ],

  "observability": {
    "enabled": true
  }
}
