/**
 * Quiver Mutation Database — one Worker serving the API (/api/*) and the
 * static frontend (Workers Static Assets). Same origin, no CORS.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qmd",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // Production hostnames (Custom Domains on the quivermutationdb.org zone).
  // Declared here so the repo fully describes the deployment; the dashboard
  // attachment was made first and deploys keep it in sync.
  "routes": [
    { "pattern": "quivermutationdb.org", "custom_domain": true },
    { "pattern": "www.quivermutationdb.org", "custom_domain": true }
  ],

  // Static frontend (the site's HTML/CSS/JS, served as Workers Static Assets).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Multi-page static site, not an SPA: serve /404.html for missing paths.
    "not_found_handling": "404-page",
    // API requests must reach the Worker; everything else is served as assets.
    "run_worker_first": ["/api/*", "/mcp"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qmd",
      "database_id": "9b44dc6c-a114-4bf5-8c4d-bb24f9dacde8",
      // Drizzle writes migrations here (drizzle.config.ts `out`); wrangler
      // applies them with `d1 migrations apply`.
      "migrations_dir": "drizzle"
    }
  ],

  "observability": {
    "enabled": true
  }
}
